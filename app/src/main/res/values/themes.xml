<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.PocketMind" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorSecondary">@color/yellow</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.PocketMind" parent="Base.Theme.PocketMind" />

    <style name="Theme.PocketMind.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/green</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.PocketMind</item>
    </style>
</resources>
